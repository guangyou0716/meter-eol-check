{
  "name": "meter-eol-check",
  "version": "0.1.0",
  "description": "Offline CLI: smart-meter end-of-line accuracy test lot report (first-pass yield, Cpk per load point, station bias)",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "meter-eol-check": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^20",
    "eslint": "^9",
    "globals": "^16",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3"
  }
}
